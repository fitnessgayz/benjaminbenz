{
  "id": "/coach-app",
  "name": "FWB Coach",
  "short_name": "FWB Coach",
  "description": "Coach workspace for Fitness with Benjamin.",
  "start_url": "/coach-admin.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#050806",
  "theme_color": "#050806",
  "categories": ["business", "fitness", "productivity"],
  "shortcuts": [
    {
      "name": "Coach home",
      "short_name": "Home",
      "url": "/coach-admin.html?tab=home"
    },
    {
      "name": "Coach inbox",
      "short_name": "Inbox",
      "url": "/coach-admin.html?tab=inbox"
    },
    {
      "name": "Manage clients",
      "short_name": "Clients",
      "url": "/coach-admin.html?tab=clients"
    },
    {
      "name": "Log a workout",
      "short_name": "Workout log",
      "url": "/coach-workout-log.html"
    },
    {
      "name": "Exercise library",
      "short_name": "Exercises",
      "url": "/coach-exercise-library.html"
    }
  ],
  "icons": [
    {
      "src": "/fwb-brand-icon-gold-180-v5.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/fwb-brand-icon-gold-192-v5.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/fwb-brand-icon-gold-512-v5.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/fwb-brand-icon-gold-1024-v5.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
