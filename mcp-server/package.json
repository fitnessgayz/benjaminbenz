{
  "name": "benjamin-ai-coach-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Authenticated MCP server for the FWB Coach ChatGPT app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "supabase:start": "supabase start --workdir .. --exclude edge-runtime",
    "supabase:stop": "supabase stop --workdir ..",
    "test:db": "node scripts/test-local-db.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.112.3",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "supabase": "2.114.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
