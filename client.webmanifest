{
  "id": "/client-dashboard.html",
  "name": "GRUNTR",
  "short_name": "GRUNTR",
  "description": "Your GRUNTR training plan, progress, and coach connection.",
  "start_url": "/client-dashboard.html",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#050806",
  "theme_color": "#050806",
  "categories": [
    "fitness",
    "health",
    "lifestyle"
  ],
  "shortcuts": [
    {
      "name": "Start training",
      "short_name": "Train",
      "url": "/client-dashboard.html?tab=workouts"
    },
    {
      "name": "View progress",
      "short_name": "Progress",
      "url": "/client-dashboard.html?tab=progress"
    },
    {
      "name": "Message your coach",
      "short_name": "Messages",
      "url": "/client-dashboard.html?messages=1"
    }
  ],
  "icons": [
    {
      "src": "/images/gruntr/client-pulse-1380/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/gruntr/client-pulse-1380/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/gruntr/client-pulse-1380/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/gruntr/client-pulse-1380/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/gruntr/client-pulse-1380/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/gruntr/client-pulse-1380/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
